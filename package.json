{
  "name": "cursor-codex-gateway",
  "version": "1.1.0",
  "description": "Cursor subscription → OpenAI Chat Completions, Codex /v1/responses, and Claude Code /v1/messages. Based on pwnapplehat/Cursor-OpenAI.",
  "keywords": [
    "cursor",
    "openai",
    "codex",
    "claude-code",
    "anthropic",
    "openai-compatible",
    "responses-api",
    "llm-gateway",
    "cursor-sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxy906/cursor-codex-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/mxy906/cursor-codex-gateway/issues"
  },
  "homepage": "https://github.com/mxy906/cursor-codex-gateway#readme",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "cursor-gateway": "bin/cursor-gateway.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.all.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "node scripts/run-tests.mjs",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:tools": "tsx scripts/smoke-test-tools.ts",
    "smoke:streaming-tools": "tsx scripts/smoke-test-streaming-tools.ts",
    "smoke:hold-mode": "tsx scripts/smoke-test-hold-mode.ts",
    "smoke:messages": "tsx scripts/smoke-messages.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.22",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
